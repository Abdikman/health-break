{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Health Break",
	"version": "0.1.0",
	"identifier": "com.healthbreak.app",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"trayIcon": {
			"iconPath": "icons/icon.png",
			"showMenuOnLeftClick": false
		},
		"windows": [
			{
				"label": "main",
				"title": "Health Break",
				"width": 800,
				"height": 600,
				"visible": true
			},
			{
				"label": "notification",
				"url": "notification.html",
				"width": 320,
				"height": 110,
				"decorations": false,
				"transparent": true,
				"alwaysOnTop": true,
				"visible": false,
				"resizable": false,
				"skipTaskbar": true,
				"shadow": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/sounds/*", "$APPDATA/sounds/**/*"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
